# All variables in this file are server-side. Do not use NEXT_PUBLIC for secrets.
DATABASE_URL=postgresql://username:password@host:5432/patchbags?sslmode=require
APP_ORIGIN=https://commerce.example.com
STORE_ORIGIN=https://altaqawy.github.io
COOKIE_SIGNING_KEY_BASE64=replace_with_random_base64_of_32_bytes
PAYMOB_ENCRYPTION_KEY_BASE64=replace_with_separate_random_base64_of_32_bytes
# Owner bootstrap once using SQL (see README). Never commit password hashes in repo.
# When deployed behind separate static site: expose only the specific production origin.
CORS_ALLOWED_ORIGIN=https://altaqawy.github.io

# Optional owner-managed product photos, videos and GLB model upload (private S3-compatible / R2).
# Save these as secrets only in the secure backend deployment. Never in GitHub Pages.
MEDIA_S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
MEDIA_S3_REGION=auto
MEDIA_S3_BUCKET=patchbags-products
MEDIA_S3_ACCESS_KEY_ID=replace_in_secret_manager
MEDIA_S3_SECRET_ACCESS_KEY=replace_in_secret_manager
MEDIA_PUBLIC_BASE_URL=https://media.yourstore-domain.com

# Verified Supabase Auth (customer accounts) — public publishable key only.
# Never use Supabase service_role in these variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace
