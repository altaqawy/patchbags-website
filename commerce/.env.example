# All variables in this file are server-side. Do not use NEXT_PUBLIC for secrets.
DATABASE_URL=postgresql://username:password@host:5432/patchbags?sslmode=require
APP_ORIGIN=https://commerce.example.com
STORE_ORIGIN=https://altaqawy.github.io
COOKIE_SIGNING_KEY_BASE64=replace_with_random_base64_of_32_bytes
PAYMOB_ENCRYPTION_KEY_BASE64=replace_with_separate_random_base64_of_32_bytes
# Owner bootstrap once using SQL (see README). Never commit password hashes in repo.
# When deployed behind separate static site: expose only the specific production origin.
CORS_ALLOWED_ORIGIN=https://altaqawy.github.io
